<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Respaldo en la nube detectado ☁️"
        android:textColor="@color/yolka_text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRestoreBackupDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Encontramos una copia cifrada (.v2.ylk) de tus mascotas, vacunas y rutinas en Yolka Cloud. ¿Deseas restaurarla ahora?"
        android:textColor="@color/yolka_text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/pbRestoreBackup"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omitir"
            android:textColor="@color/yolka_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmRestore"
            style="@style/Widget.Yolka.DeepButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Restaurar respaldo"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
