<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yolka_background"
    android:orientation="vertical"
    android:padding="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rutinas y Hábitos 🕒"
                android:textColor="@color/yolka_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alimentación, paseos y cuidados estéticos"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenNewRoutine"
            style="@style/Widget.Yolka.DeepButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:text="+ Nueva Rutina"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Selector horizontal de mascotas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutinesPetsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal" />

    <!-- Filtros por categoría (Todas | Alimentación | Paseos | Higiene) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_input"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="4">

        <TextView
            android:id="@+id/filterAllRoutines"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center"
            android:text="Todas"
            android:textColor="@color/yolka_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterFeedingRoutines"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🍴 Comida"
            android:textColor="@color/yolka_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterWalkRoutines"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐾 Paseos"
            android:textColor="@color/yolka_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterHygieneRoutines"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛁 Higiene"
            android:textColor="@color/yolka_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutinesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvEmptyRoutinesState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_card"
        android:gravity="center"
        android:padding="20dp"
        android:text="No hay rutinas en esta categoría. Toca '+ Nueva Rutina' para programar horarios de alimentación, paseos o baños."
        android:textColor="@color/yolka_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
