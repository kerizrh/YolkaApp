<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yolka_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar estilo  (Captura 3: Logo Yolka + Subtítulo + Campana + Avatar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/yolka_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/ivTopBarMenuLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/bg_yolka_logo_badge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/yolka_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopBarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:textColor="@color/yolka_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTopNotifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notificaciones"
                android:src="@drawable/ic_bell" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTopUserAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/yolka_primary"
                app:cardCornerRadius="19dp"
                app:strokeColor="@color/yolka_primary_deep"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tvTopUserInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="@color/yolka_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/yolka_divider" />

        <!-- Banner Modo Parcialmente Offline / Cola Pendiente -->
        <TextView
            android:id="@+id/tvOfflineSyncBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/badge_nutrition_bg"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/offline_banner"
            android:textColor="@color/badge_nutrition_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Contenedor Principal de Fragmentos -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Navegación Inferior (Captura 3, 5, 9 de ) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/yolka_bottom_nav_bg"
            app:itemIconTint="@color/yolka_primary_deep"
            app:itemTextColor="@color/yolka_text_primary"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- Sidebar / Drawer Lateral Derecho -->
    <LinearLayout
        android:id="@+id/drawerRightContainer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/yolka_surface"
        android:orientation="vertical">

        <!-- Navigation View con Header (Logo, X, ProfileCard) y Menú (Notificaciones, Ajustes) -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/yolka_surface"
            app:headerLayout="@layout/nav_header_main"
            app:itemIconTint="@color/yolka_primary_deep"
            app:itemTextColor="@color/yolka_text_primary"
            app:menu="@menu/drawer_nav_menu" />

        <!-- Separador y Cerrar Sesión Pinned al Fondo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/yolka_divider" />

        <LinearLayout
            android:id="@+id/btnDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Cerrar sesión"
                android:src="@drawable/ic_logout"
                app:tint="@color/yolka_danger" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Cerrar sesión"
                android:textColor="@color/yolka_danger"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
