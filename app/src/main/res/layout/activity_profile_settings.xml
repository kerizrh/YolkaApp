<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yolka_background"
    android:orientation="vertical">

    <!-- Top Bar (Fiel a Captura 11 de Figma) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Ajustes de Perfil"
            android:textColor="@color/yolka_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/bg_yolka_logo_badge" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yolka_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar Circular con Badge de Cámara (Captura 11 Figma) -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="106dp"
                    android:layout_height="106dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/yolka_surface_variant"
                    app:cardCornerRadius="53dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/yolka_primary"
                    app:strokeWidth="2.5dp">

                    <ImageView
                        android:id="@+id/ivProfileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_yolka_logo_badge" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnChangePhotoBadge"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    app:cardBackgroundColor="@color/yolka_primary"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/yolka_background"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Cambiar foto"
                        android:padding="7dp"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/yolka_on_primary" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:id="@+id/tvProfileFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Carlos Mendoza"
                android:textColor="@color/yolka_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="carlos.mendoza@email.com"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleEditProfile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Editar perfil"
                android:textAllCaps="false"
                android:textColor="@color/yolka_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/yolka_surface_variant"
                app:cornerRadius="20dp"
                app:strokeColor="@color/yolka_stroke"
                app:strokeWidth="1dp" />

            <!-- Panel desplegable para Editar Perfil -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfileForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/yolka_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/yolka_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTUALIZAR DATOS PERSONALES"
                        android:textColor="@color/yolka_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEditFullName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Nombre completo"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/yolka_text_primary"
                        android:textColorHint="@color/yolka_text_muted"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etEditPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Teléfono móvil"
                        android:inputType="phone"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/yolka_text_primary"
                        android:textColorHint="@color/yolka_text_muted"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etEditPhotoUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="URL de fotografía de perfil (opcional)"
                        android:inputType="textUri"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/yolka_text_primary"
                        android:textColorHint="@color/yolka_text_muted"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:text="Guardar cambios"
                        android:textAllCaps="false"
                        android:textColor="@color/yolka_on_primary"
                        android:textStyle="bold"
                        app:backgroundTint="@color/yolka_primary"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección CUENTA & SEGURIDAD (Captura 11 Figma) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="CUENTA &amp; SEGURIDAD"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Card: Cambiar Contraseña -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChangePasswordToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/yolka_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/yolka_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_chip"
                            android:contentDescription="Seguridad"
                            android:padding="9dp"
                            android:src="@drawable/ic_yolka_paw" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cambiar contraseña"
                                android:textColor="@color/yolka_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Protege el acceso a tu cuenta"
                                android:textColor="@color/yolka_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Formulario inline de cambio de contraseña -->
                    <LinearLayout
                        android:id="@+id/layoutPasswordForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/etCurrentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Contraseña actual"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/yolka_text_primary"
                            android:textColorHint="@color/yolka_text_muted"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input_field"
                            android:hint="Nueva contraseña (mín. 8 caracteres)"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/yolka_text_primary"
                            android:textColorHint="@color/yolka_text_muted"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitPasswordChange"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="Actualizar contraseña"
                            android:textAllCaps="false"
                            android:textColor="@color/yolka_on_primary"
                            android:textStyle="bold"
                            app:backgroundTint="@color/yolka_primary"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Respaldo en la nube (.v2.ylk AES-256-GCM - Captura 11 Figma) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/yolka_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/yolka_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_chip"
                            android:contentDescription="Respaldo"
                            android:padding="9dp"
                            android:src="@drawable/ic_calendar" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Respaldo en la nube"
                                android:textColor="@color/yolka_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Cifrado AES-256-GCM (.v2.ylk)"
                                android:textColor="@color/yolka_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBackupStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Sincronizado"
                            android:textColor="@color/badge_health_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvLastBackupTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Última copia: Hoy, 14:30"
                            android:textColor="@color/yolka_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCreateCloudBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Crear copia"
                            android:textAllCaps="false"
                            android:textColor="@color/yolka_on_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/yolka_primary"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnRestoreCloudBackup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:padding="4dp"
                        android:text="Restaurar copia desde el servidor"
                        android:textColor="@color/yolka_primary_deep"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Danger Zone: Eliminar cuenta permanentemente (Captura 11 Figma) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/yolka_surface_variant"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/yolka_danger"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eliminar cuenta permanentemente"
                        android:textColor="@color/yolka_danger"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Esta acción borrará todos los perfiles y registros médicos de tus mascotas sin posibilidad de recuperación."
                        android:textColor="@color/yolka_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
