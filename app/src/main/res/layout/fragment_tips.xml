<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yolka_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consejos y Bienestar 💡"
        android:textColor="@color/yolka_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Recomendaciones de alimentación, higiene, salud y datos curiosos"
        android:textColor="@color/yolka_text_secondary"
        android:textSize="12sp" />

    <!-- Filtro por Especie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_input"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="3">

        <TextView
            android:id="@+id/btnTipsSpeciesAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center"
            android:text="🐾 Todos"
            android:textColor="@color/yolka_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTipsSpeciesDog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐶 Perros"
            android:textColor="@color/yolka_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTipsSpeciesCat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐱 Gatos"
            android:textColor="@color/yolka_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filtro horizontal por Categoría (Módulo 7 Yolka.md) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTipCatAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_input"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Todas"
                android:textColor="@color/yolka_primary_deep"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipTipCatFeeding"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Alimentación"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTipCatHygiene"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Higiene"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTipCatExercise"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Ejercicios y paseos"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTipCatVaccines"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Vacunación"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipTipCatFun"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Datos curiosos"
                android:textColor="@color/yolka_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTipsCatalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
