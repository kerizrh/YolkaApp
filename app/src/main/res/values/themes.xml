<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Yolka" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yolka_primary_deep</item>
        <item name="colorOnPrimary">@color/yolka_on_primary_deep</item>
        <item name="colorPrimaryContainer">@color/yolka_primary</item>
        <item name="colorOnPrimaryContainer">@color/yolka_on_primary</item>
        <item name="colorSecondary">@color/yolka_secondary</item>
        <item name="android:windowBackground">@color/yolka_background</item>
        <item name="colorSurface">@color/yolka_surface</item>
        <item name="colorOnSurface">@color/yolka_text_primary</item>
        <item name="colorSurfaceVariant">@color/yolka_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/yolka_text_secondary</item>
        <item name="android:statusBarColor">@color/yolka_background</item>
        <item name="android:navigationBarColor">@color/yolka_bottom_nav_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.Yolka.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/yolka_primary</item>
        <item name="android:textColor">@color/yolka_on_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.Yolka.DeepButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/yolka_primary_deep</item>
        <item name="android:textColor">@color/yolka_on_primary_deep</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Yolka.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Yolka.RoundedCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
